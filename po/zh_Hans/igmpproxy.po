msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "igmpproxy"
msgstr "igmpproxy"

msgid "IGMP Proxy"
msgstr "IGMPPROXY设置"

msgid "IGMP Proxy Configuration"
msgstr "IGMPPROXY配置"

msgid "General Settings"
msgstr "通用设置"

msgid "Quick Leave"
msgstr "快速离开"

msgid "Send leave messages immediately on departure of the last member."
msgstr "在一位成员离开时立即发送离开消息,可能会造成其他成员卡顿几秒"

msgid "Enable quickleave mode"
msgstr "启用快速离开模式"

msgid "Verbose Level"
msgstr "日志详细级别"

msgid "0=none, 1=minimal, 2=more, 3=max"
msgstr "0=无，1=最少，2=适中，3=最大"

msgid "Physical Interfaces"
msgstr "接口设置"

msgid "Configure physical interfaces for multicast routing.\"Disabled\" is applicable to \"lo\" or \"loopback\" interface"
msgstr "配置用于组播路由的接口，“禁用”适用于lo或者loopback接口，下拉没有时可自行创建。如果保存后/etc/igmpproxy.conf无法生成对应行说明接口选择错误，应该优先选择别名接口。"

msgid "Add Interface"
msgstr "添加接口"

msgid "Direction"
msgstr "组播方向"

msgid "Select the multicast routing direction"
msgstr "选择组播路由方向或禁用方向"

msgid "Upstream (toward source)"
msgstr "上行（组播来源方向）"

msgid "Downstream (toward receivers)"
msgstr "下行（组播接收方向）"

msgid "Disabled"
msgstr "禁用"

msgid "Network Interface"
msgstr "网络接口"

msgid "Select the network interface to use."
msgstr "选择要使用的网络接口，请先选择别名接口"

msgid "Firewall Zone"
msgstr "防火墙区域"

msgid "Assign this interface to a firewall zone"
msgstr "将该接口分配到防火墙区域，自行决定是否需要加入防火墙"

msgid "Alternative Networks"
msgstr "附加网络"

msgid "Additional networks considered as directly connected"
msgstr "被视为直连的附加网络"

msgid "Placeholder: 10.0.0.0/8"
msgstr "占位示例: 10.0.0.0/8"

msgid "Define additional networks allowed to join multicast."
msgstr "定义允许加入组播的附加网络，查询日志决定上行可直连的网络。下行放行可默认不填，一般是接收设备ip段"

msgid "IGMP Proxy allows multicast traffic to be properly forwarded between networks，ipv4 only.by:github.com/xiaren2"
msgstr "IGMPPROXY允许在网络间正确转发组播流量，仅支持ipv4，igmpproxy仅支持一个上行，多个下行。by:github.com/xiaren2"

msgid "Start"
msgstr "启动"

msgid "Stop"
msgstr "停止"

msgid "Restart"
msgstr "重启"

msgid "Refresh"
msgstr "刷新"

msgid "Status: "
msgstr "运行状态："

msgid "Running"
msgstr "运行中"

msgid "Stopped"
msgstr "未运行"

msgid "Error"
msgstr "错误"

msgid "Checking status..."
msgstr "正在检测状态..."

msgid "Find Alternative Networks"
msgstr "查找附加网络"

msgid "Detect alternative networks from logs:"
msgstr "从日志中检测附加网络："

msgid "Scanning logs..."
msgstr "正在扫描日志..."

msgid "No alternative network addresses found."
msgstr "未找到附加网络地址,先把上下行网络防火墙配置好，播放一次rtp:// 后，再尝试。"

msgid "No data"
msgstr "暂无数据"

msgid "Add"
msgstr "添加"

msgid "Added"
msgstr "已添加"

msgid "No upstream"
msgstr "请先新建组播上行后再添加"

msgid "Exists"
msgstr "已存在"
